{%- assign cfg = product.metafields.bundlekit.config.value -%}
{%- if cfg != blank and cfg.handles.size > 1 -%}
  {%- assign total = 0 -%}
  {%- assign variant_ids = '' -%}
  {%- assign all_available = true -%}
  <div class="bk" data-bk-root>
    <h3 class="bk_title">{{ block.settings.heading }}</h3>
    <ul class="bk_list">
      {%- for handle in cfg.handles -%}
        {%- assign p = all_products[handle] -%}
        {%- unless p.id -%}
          {%- assign all_available = false -%}
          {%- continue -%}
        {%- endunless -%}
        {%- if p.id == product.id -%}
          {%- assign v = product.selected_or_first_available_variant -%}
        {%- else -%}
          {%- assign v = p.selected_or_first_available_variant -%}
        {%- endif -%}
        {%- comment -%}{%- unless v.available -%}{%- assign all_available = false -%}{%- endunless -%}{%- endcomment -%}
        {%- assign total = total | plus: v.price -%}
        {%- assign variant_ids = variant_ids | append: v.id | append: ',' -%}
        <li class="bk_item">
          {%- if p.featured_image -%}
            <img src="{{ p.featured_image | image_url: width: 120 }}" alt="{{ p.title | escape }}" width="60" height="60" loading="lazy">
          {%- endif -%}
          <span class="bk_name">{{ p.title }}</span>
          <span class="bk_price">{{ v.price | money }}</span>
        </li>
      {%- endfor -%}
    </ul>
    {%- assign factor = 100 | minus: cfg.percentage -%}
    {%- assign discounted = total | times: factor | divided_by: 100 -%}
    <p class="bk_total">
      <s>{{ total | money }}</s>
      <strong>{{ discounted | money }}</strong>
      <span class="bk_badge">-{{ cfg.percentage }}%</span>
    </p>
    <button type="button" class="bk_btn" data-bk-add data-variants="{{ variant_ids }}" {% unless all_available %}disabled{% endunless %}>
      {% if all_available %}{{ block.settings.button_label }}{% else %}Indisponible{% endif %}
    </button>
    <p class="bk_error" data-bk-error hidden></p>
  </div>
{%- endif -%}

<style>
.bk { border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin: 16px 0; }
.bk_title { margin: 0 0 12px; }
.bk_list { list-style: none; margin: 0; padding: 0; }
.bk_item { display: flex; align-items: center; gap: 12px; padding: 6px 0; }
.bk_item img { border-radius: 4px; object-fit: cover; }
.bk_name { flex: 1; }
.bk_total { margin: 12px 0; display: flex; align-items: center; gap: 8px; }
.bk_badge { background: #1a7f37; color: #fff; border-radius: 4px; padding: 2px 6px; font-size: 0.85em; }
.bk_btn { width: 100%; padding: 12px; border: 0; border-radius: 6px; background: #111; color: #fff; cursor: pointer; }
.bk_btn[disabled] { opacity: 0.5; cursor: not-allowed; }
.bk_error { color: #b42318; margin: 8px 0 0; }
</style>

<script>
document.addEventListener('click', async function (event) {
  var btn = event.target.closest('[data-bk-add]');
  if (!btn || btn.disabled) return;
  var root = btn.closest('[data-bk-root]');
  var errorEl = root.querySelector('[data-bk-error]');
  errorEl.hidden = true;
  var items = btn.dataset.variants.split(',').filter(Boolean).map(function (id) {
    return { id: Number(id), quantity: 1 };
  });
  btn.disabled = true;
  try {
    var res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    });
    if (!res.ok) throw new Error('add failed');
    var base = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    window.location.href = base + 'cart';
  } catch (e) {
    errorEl.textContent = "Impossible d'ajouter le pack. Réessayez.";
    errorEl.hidden = false;
    btn.disabled = false;
  }
});
</script>

{% schema %}
{
  "name": "Bundle",
  "target": "section",
  "templates": ["product"],
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Souvent achetés ensemble" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Ajouter le pack au panier" }
  ]
}
{% endschema %}